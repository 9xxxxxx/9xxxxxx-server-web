// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // 哈希后的密码
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  posts     Post[]
  projects  Project[]
  comments  Comment[]
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  content     String   @db.Text
  published   Boolean  @default(false)
  category    String   @default("Tech")
  coverImage  String?
  tags        String[]
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    Comment[]
  
  @@index([published])
  @@index([authorId])
}

model Project {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String
  fullDescription String   @db.Text
  techStack       String[]
  features        String[]
  githubLink      String?
  demoLink        String?
  image           String
  category        String?
  published       Boolean  @default(true)
  likes           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  authorId        String
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments        Comment[]
  
  @@index([published])
  @@index([authorId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  guestName String   @default("Guest")
  createdAt DateTime @default(now())
  
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Optional: Link to registered user if we ever want to track, but keeping simple for now
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([projectId])
}

model SiteConfig {
  id             String   @id @default(cuid())
  ownerName      String   @default("Garry")
  avatarInitial  String   @default("G")
  avatarGradient String   @default("from-blue-600 to-indigo-600")
  avatarImage    String?  // Custom uploaded image path
  siteTitle      String?  @default("Portfolio")
  updatedAt      DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  path      String
  browser   String?
  os        String?
  device    String?  @default("desktop")
  country   String?
  ip        String?  // Optional: hashed IP for uniqueness check (privacy focused)
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}
